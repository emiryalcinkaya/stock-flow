# Copy this file to .env and adjust the values.

app_name=StockFlow
database_url=postgresql+psycopg2://stockflow_user:stockflow_password@localhost:5432/stockflow_db

# Generate a strong key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
secret_key=change-me-to-a-long-random-string
algorithm=HS256
access_token_expire_minutes=60

# Comma separated list of origins allowed to call the API (the frontend URL).
cors_origins=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

low_stock_threshold=5
login_max_attempts=5
login_lockout_seconds=300
log_level=INFO

# Used by `python -m app.db.seed` (demo defaults: admin123 / cashier123).
SEED_ADMIN_PASSWORD=admin123
SEED_CASHIER_PASSWORD=cashier123
